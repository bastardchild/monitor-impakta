# ==============================================================================
# SOCIAL MEDIA KPI DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Base URL aplikasi (Domain publik HTTPS untuk callback OAuth)
# Contoh produksi: https://kpi.domainanda.com
# Contoh development: http://127.0.0.1:8000
BASE_URL=http://127.0.0.1:8000

# Timezone
TZ=Asia/Jakarta

# Turso Cloud Database
# Untuk Turso: libsql://[nama-db]-[organisasi].turso.io
# Untuk lokal dev / test: file:/tmp/local.db atau file:local.db
TURSO_DATABASE_URL=libsql://kpi-sosmed-user.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Secret Keys (Gunakan: docker compose run --rm tools python scripts/generate_keys.py)
APP_SECRET_KEY=generate_with_generate_keys_py_at_least_32_chars
TOKEN_ENCRYPTION_KEY=generate_fernet_key_with_generate_keys_py
INGEST_API_KEY=generate_secure_random_api_key_for_n8n

# Admin Login (Single User)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$EXAMPLEHASHGENERATEWITHGENERATEKEYSPY

# Keamanan Cookie Session (Set 'true' jika deploy dengan HTTPS / Cloudflare Tunnel)
SECURE_COOKIES=false

# ------------------------------------------------------------------------------
# OAUTH KREDENSIAL PLATFORM
# ------------------------------------------------------------------------------

# Google / YouTube Data API & Analytics API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Meta / Instagram Graph API
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_GRAPH_VERSION=v21.0

# TikTok Developer API (v2)
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# ------------------------------------------------------------------------------
# N8N ORCHESTRATION & WEBHOOKS
# ------------------------------------------------------------------------------

# N8N Encryption Key (wajib persist agar n8n credential tetap terbaca saat restart)
N8N_ENCRYPTION_KEY=generate_random_key_with_generate_keys_py

# Webhook Trigger URLs (Internal network: dipanggil langsung oleh app FastAPI)
N8N_WEBHOOK_URL_YOUTUBE=http://n8n:5678/webhook/sync-youtube
N8N_WEBHOOK_URL_INSTAGRAM=http://n8n:5678/webhook/sync-instagram
N8N_WEBHOOK_URL_TIKTOK=http://n8n:5678/webhook/sync-tiktok

# Webhook Secret Header untuk memvalidasi pemanggilan webhook
N8N_WEBHOOK_SECRET=generate_secret_with_generate_keys_py

# N8N Environment Access (Workflow membaca INGEST_API_KEY via env)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ------------------------------------------------------------------------------
# CLOUDFLARE TUNNEL (Opsional - Profile 'tunnel')
# ------------------------------------------------------------------------------
TUNNEL_TOKEN=your-cloudflared-tunnel-token
