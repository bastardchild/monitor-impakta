          }
        ]
      ]
    },
    "Normalisasi Instagram Media": {
      "main": [
        [
          {
            "node": "Ingest Instagram Posts ke App",
            "type": "main",
            "index": 0
          },
          {
            "node": "Ingest Instagram Post Metrics ke App",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
