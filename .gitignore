# ==============================================================================
# IMPAKTA RADAR - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials
# ------------------------------------------------------------------------------
# Seluruh file .env diabaikan kecuali cetak biru .env.example
.env
.env.*
!.env.example
*.env.local
*.env.production

# Kunci Kriptografi & Sertifikat
*.pem
*.key
*.crt
*.pfx

# ------------------------------------------------------------------------------
# 2. Local Databases & Persistence
# ------------------------------------------------------------------------------
# Database lokal LibSQL / SQLite dan file jurnal
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
local.db
app.db
data/

# Data volume lokal n8n
.n8n/
n8n_data/

# ------------------------------------------------------------------------------
# 3. Docker Local Overrides
# ------------------------------------------------------------------------------
# Override compose lokal (misal: custom mapping port untuk dev lokal)
docker-compose.override.yml

# ------------------------------------------------------------------------------
# 4. Python Runtime & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environment
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging & Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 5. Testing & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 6. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.bak

# ------------------------------------------------------------------------------
# 7. OS & Editor Specific Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Editors & IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
